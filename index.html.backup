        // Set Realtime Hindi Date Display
        function updateCurrentDate() {
            const dateObj = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateStr = dateObj.toLocaleDateString('hi-IN', options);
            document.getElementById('currentDateDisplay').innerText = dateStr;
            document.getElementById('epaperDateTitle').innerText = dateStr;
        }

