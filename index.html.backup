                <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-xs uppercase tracking-wider">
                    <i class="fa-solid fa-check-to-slot text-sm"></i>
                    <span>आज का जनमत (Daily Opinion Poll)</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100" id="pollQuestionText">
                    क्या एआई (Artificial Intelligence) तकनीक से ग्रामीण भारत में रोजगार और कृषि उत्पादन को बड़ा बढ़ावा मिलेगा?
                </h3>

                <div id="pollOptionsContainer" class="space-y-3 pt-2">
                    <button onclick="castVote('yes')" class="w-full text-left p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-news-500 bg-slate-50 dark:bg-slate-800 transition flex items-center justify-between group">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 group-hover:text-news-600">हाँ, निश्चित तौर पर</span>
                        <span id="votePercentYes" class="text-xs font-extrabold text-news-600">68%</span>
                    </button>
                    <button onclick="castVote('no')" class="w-full text-left p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-news-500 bg-slate-50 dark:bg-slate-800 transition flex items-center justify-between group">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 group-hover:text-news-600">नहीं, कोई खास प्रभाव नहीं</span>
                        <span id="votePercentNo" class="text-xs font-extrabold text-slate-500">22%</span>
                    </button>
                    <button onclick="castVote('maybe')" class="w-full text-left p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-news-500 bg-slate-50 dark:bg-slate-800 transition flex items-center justify-between group">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 group-hover:text-news-600">कह नहीं सकते</span>
                        <span id="votePercentMaybe" class="text-xs font-extrabold text-slate-500">10%</span>
                    </button>
