<!DOCTYPE html>
<html lang="hi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>द स्पीक - डिजिटल ई-पेपर और समाचार पोर्टल</title>
    
    <!-- Content Security Policy -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data:; font-src 'self' https:; style-src 'self' https: 'unsafe-inline'; script-src 'self' https: 'unsafe-inline' 'unsafe-eval';">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts for Hindi and Modern Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Rozha+One&family=Yatra+One&family=Tiro+Devanagari+Hindi:ital@0;1&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind Custom Styles & Fonts Configuration -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Poppins"', 'sans-serif'],
                        'hindi-title': ['"Yatra One"', 'serif'],
                        'hindi-serif': ['"Rozha One"', 'serif'],
                        'hindi-body': ['"Tiro Devanagari Hindi"', 'serif'],
                    },
                    colors: {
                        news: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            500: '#f43f5e',
                            600: '#e11d48',
                            700: '#be123c',
                            800: '#9f1239',
                            900: '#881337',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        .font-hindi-title { font-family: 'Yatra One', serif; }
        .font-hindi-serif { font-family: 'Rozha One', serif; }
        .font-hindi-body { font-family: 'Tiro Devanagari Hindi', serif; }
        
        body {
            font-family: 'Poppins', 'Tiro Devanagari Hindi', sans-serif;
        }

        /* E-Paper Clipping Hotspot Effect */
        .epaper-hotspot {
            position: relative;
            transition: all 0.2s ease-in-out;
            border: 1px dashed rgba(225, 29, 72, 0.3);
        }
        .epaper-hotspot:hover {
            border: 2px solid #e11d48;
            background-color: rgba(225, 29, 72, 0.08);
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.15);
        }

        /* Ticker Animation */
        @keyframes ticker {
            0% { transform: translate3d(0, 0, 0); }
            100% { transform: translate3d(-50%, 0, 0); }
        }
        .animate-ticker {
            display: inline-flex;
            white-space: nowrap;
            animation: ticker 35s linear infinite;
        }
        .animate-ticker:hover {
            animation-play-state: paused;
        }

        /* Newspaper Paper Texture Styling */
        .paper-texture {
            background-color: #fdfbf7;
            background-image: radial-gradient(#e5e0d8 0.5px, transparent 0.5px);
            background-size: 12px 12px;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .dark ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #e11d48;
            border-radius: 3px;
        }
    </style>
</head>

<body class="bg-slate-100 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col justify-between transition-colors duration-200">

    <!-- Top Announcement Bar -->
    <div class="bg-news-700 text-white text-xs py-2 px-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-4 text-xs font-medium">
                <span class="flex items-center gap-1.5">
                    <i class="fa-solid fa-calendar-days text-news-200"></i>
                    <span id="currentDateDisplay">मंगलवार, 15 सितंबर 2026</span>
                </span>
                <span class="hidden sm:flex items-center gap-1.5 border-l border-news-600 pl-4">
                    <i class="fa-solid fa-cloud-sun text-amber-300"></i>
                    <span>बरेली: 29°C (साफ मौसम)</span>
                </span>
                <span class="hidden md:flex items-center gap-1.5 border-l border-news-600 pl-4">
                    <i class="fa-solid fa-location-dot text-news-200"></i>
                    <span>संस्करण: <strong id="topEditionLabel" class="text-amber-200 font-bold">बरेली नगर</strong></span>
                </span>
            </div>

            <div class="flex items-center gap-3 text-xs">
                <a href="#epaper" class="hover:text-amber-200 transition font-semibold">ई-पेपर</a>
                <span>|</span>
                <a href="#blogs" class="hover:text-amber-200 transition">ब्लॉग</a>
                <span>|</span>
                <button onclick="openBookmarksModal()" class="hover:text-amber-200 transition flex items-center gap-1">
                    <i class="fa-solid fa-bookmark text-amber-300"></i>
                    <span>सेव की गई खबरें (<span id="bookmarkCount">0</span>)</span>
                </button>
                <span>|</span>
                <button onclick="toggleDarkMode()" class="hover:text-amber-200 transition p-1" title="लाइट / डार्क मोड">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Header & Branding -->
    <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            
            <!-- Brand Title -->
            <a href="#" class="text-center md:text-left group flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-news-700 text-white font-hindi-title text-2xl flex items-center justify-center shadow-lg shadow-news-700/20 group-hover:scale-105 transition-transform">
                    स्पीक
                </div>
                <div>
                    <h1 class="text-3xl md:text-5xl font-hindi-title text-news-700 dark:text-news-500 tracking-wider leading-none">द स्पीक</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">निष्पक्ष पत्रकारिता • डिजिटल ई-पेपर एवं विश्वसनीय समाचार मंच</p>
                </div>
            </a>

            <!-- Edition Selector, Quick Date & Search Bar -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center gap-1.5 bg-slate-100 dark:bg-slate-800 p-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                    <i class="fa-solid fa-city text-news-600 dark:text-news-400 text-xs pl-2"></i>
                    <select id="editionSelect" onchange="changeEdition(this.value)" class="bg-transparent text-xs font-semibold text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer pr-2">
                        <option value="bareilly" class="dark:bg-slate-800">बरेली नगर</option>
                        <option value="lucknow" class="dark:bg-slate-800">लखनऊ</option>
                        <option value="delhi" class="dark:bg-slate-800">दिल्ली NCR</option>
                        <option value="patna" class="dark:bg-slate-800">पटना</option>
                        <option value="varanasi" class="dark:bg-slate-800">वाराणसी</option>
                    </select>
                </div>

                <!-- Global Search Input -->
                <div class="relative">
                    <input type="text" id="searchInput" onkeyup="handleSearchKey(event)" placeholder="खबरें या विषय खोजें..." class="w-48 sm:w-60 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-news-500 text-slate-800 dark:text-slate-100">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                </div>

                <button onclick="executeSearch()" class="bg-news-600 hover:bg-news-700 text-white px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow transition">
                    खोजें
                </button>
            </div>
        </div>

        <!-- BREAKING NEWS TICKER -->
        <div class="bg-slate-900 text-white text-xs border-t border-slate-800 flex items-center overflow-hidden">
            <div class="bg-news-600 text-white font-bold px-4 py-2 uppercase tracking-wider flex items-center gap-2 whitespace-nowrap shrink-0 z-10 shadow-md">
                <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                <i class="fa-solid fa-bolt"></i>
                <span>ताज़ा समाचार</span>
            </div>
            <div class="overflow-hidden w-full relative py-2">
                <div id="tickerContent" class="animate-ticker space-x-12">
                    <!-- Dynamic Ticker Items -->
                </div>
            </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="bg-slate-900 border-t border-slate-800 text-slate-200">
            <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
                <div class="flex items-center space-x-1 sm:space-x-6 overflow-x-auto py-2.5 text-xs sm:text-sm font-semibold scrollbar-none">
                    <a href="#home" class="hover:text-news-400 text-news-400 transition whitespace-nowrap px-2 py-1 rounded-lg bg-slate-800/80"><i class="fa-solid fa-house mr-1"></i> होम</a>
                    <a href="#epaper" class="hover:text-news-400 transition whitespace-nowrap px-2 py-1"><i class="fa-solid fa-newspaper mr-1 text-news-500"></i> ई-पेपर डिजिटल</a>
                    <a href="#news" class="hover:text-news-400 transition whitespace-nowrap px-2 py-1"><i class="fa-solid fa-fire mr-1 text-amber-500"></i> मुख्य ख़बरें</a>
                    <a href="#local" class="hover:text-news-400 transition whitespace-nowrap px-2 py-1"><i class="fa-solid fa-building-flag mr-1 text-blue-400"></i> शहर & राज्य</a>
                    <a href="#blogs" class="hover:text-news-400 transition whitespace-nowrap px-2 py-1"><i class="fa-solid fa-pen-nib mr-1 text-purple-400"></i> विचार & ब्लॉग</a>
                    <a href="#polls" class="hover:text-news-400 transition whitespace-nowrap px-2 py-1"><i class="fa-solid fa-square-poll-vertical mr-1 text-emerald-400"></i> जनमत & राशिफल</a>
                    <a href="#gallery" class="hover:text-news-400 transition whitespace-nowrap px-2 py-1"><i class="fa-solid fa-camera mr-1 text-pink-400"></i> फोटो / वीडियो</a>
                </div>

                <div class="hidden lg:flex items-center text-xs font-bold text-amber-400 gap-2 shrink-0 pl-4 border-l border-slate-800">
                    <i class="fa-solid fa-phone-volume"></i>
                    <span>न्यूज़ डेस्क: 1800-SPEAK-NEWS</span>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 py-8 space-y-12 flex-grow w-full">

        <!-- DIGITAL E-PAPER VIEWER SECTION -->
        <section id="epaper" class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 p-4 sm:p-6 transition-all">
            <!-- E-Paper Controls Header -->
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center border-b border-slate-200 dark:border-slate-800 pb-4 mb-6 gap-4">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-2xl sm:text-3xl font-bold font-hindi-serif text-slate-800 dark:text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-book-open text-news-600"></i> 
                            <span>डिजिटल ई-पेपर व्यूअर</span>
                        </h2>
                        <span class="px-2.5 py-0.5 rounded-full bg-news-100 dark:bg-news-950 text-news-700 dark:text-news-400 text-xs font-extrabold uppercase">लाइव डिजिटल एडिशन</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">अखबार के किसी भी समाचार ब्लॉक पर क्लिक करके पूरा विवरण पढ़ें, प्रिंट करें अथवा क्लिप करें।</p>
                </div>

                <!-- Date & Edition Selection Controls -->
                <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto justify-between lg:justify-end">
                    <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 p-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                        <i class="fa-solid fa-calendar text-slate-400 text-xs pl-2"></i>
                        <input type="date" id="epaperDatePicker" value="2026-09-15" class="bg-transparent text-xs font-semibold text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer pr-2">
                        <button onclick="loadEpaperByDate()" class="bg-news-600 hover:bg-news-700 text-white px-3 py-1 rounded-lg text-xs font-bold transition">
                            देखें
                        </button>
                    </div>

                    <!-- E-Paper Action Tools -->
                    <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                        <button onclick="zoomEpaper('in')" title="ज़ूम इन" class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center hover:bg-news-50 dark:hover:bg-slate-600 text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                        </button>
                        <button onclick="zoomEpaper('out')" title="ज़ूम आउट" class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center hover:bg-news-50 dark:hover:bg-slate-600 text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-magnifying-glass-minus"></i>
                        </button>
                        <button onclick="resetZoomEpaper()" title="रीसेट आकार" class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center hover:bg-news-50 dark:hover:bg-slate-600 text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                        <button onclick="downloadEpaperPDFSim()" title="ई-पेपर डाउनलोड करें" class="px-3 h-8 rounded-lg bg-news-600 text-white flex items-center gap-1.5 hover:bg-news-700 text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-file-pdf"></i>
                            <span class="hidden sm:inline">PDF डाउनलोड</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Main E-Paper Page Viewer -->
                <div class="lg:col-span-3 bg-slate-200 dark:bg-slate-950 rounded-xl p-3 sm:p-6 overflow-auto min-h-[550px] max-h-[800px] flex justify-center items-start relative border border-slate-300 dark:border-slate-800">
                    
                    <div id="epaperCanvasContainer" class="paper-texture text-slate-900 shadow-2xl max-w-3xl w-full border-2 border-slate-800 p-6 sm:p-8 transition-transform duration-300 transform origin-top">
                        <!-- Newspaper Header Banner -->
                        <div class="text-center border-b-4 border-slate-900 pb-3 mb-6 relative">
                            <div class="flex justify-between items-center text-[10px] sm:text-xs font-bold text-slate-700 border-b border-slate-400 pb-1 mb-2">
                                <span>वर्ष: 14 • अंक: 282</span>
                                <span id="epaperDateTitle" class="font-bold text-news-700">मंगलवार, 15 सितंबर 2026</span>
                                <span>मूल्य: ₹5.00 • पृष्ठ: <span id="activePageNumText">01</span></span>
                            </div>
                            <h3 class="text-4xl sm:text-6xl font-hindi-title text-news-800 tracking-widest my-1">द स्पीक</h3>
                            <p class="text-xs sm:text-sm font-semibold text-slate-700 font-hindi-body">
                                <span id="epaperEditionTitle">बरेली नगर संस्करण</span> — दैनिक निष्पक्ष समाचार एवं जन-आवाज डिजिटल पत्र
                            </p>
                        </div>

                        <!-- Dynamic Newspaper Page Articles Content -->
                        <div id="epaperArticlesGrid" class="grid grid-cols-1 md:grid-cols-12 gap-4">
                            <!-- Injected dynamically based on active page -->
                        </div>

                        <!-- Newspaper Footer Note -->
                        <div class="mt-8 pt-3 border-t-2 border-slate-900 flex justify-between items-center text-[10px] text-slate-600 font-semibold">
                            <span>स्वामी, मुद्रक व प्रकाशक: द स्पीक डिजिटल नेटवर्क प्राइवेट लिमिटेड</span>
                            <span>पृष्ठ संख्या <span id="activePageFooter">01</span> / 06</span>
                        </div>
                    </div>
                </div>

                <!-- Page Thumbnail & Page Navigation Sidebar -->
                <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl p-4 flex flex-col space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-2">
                        <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-layer-group text-news-600"></i>
                            <span>पन्ने चुनें (Pages)</span>
                        </h4>
                        <span class="text-xs font-bold text-slate-500">कुल 6 पन्ने</span>
                    </div>

                    <!-- Page Thumbnail Buttons Grid -->
                    <div class="grid grid-cols-2 gap-3" id="pageSelectorButtons">
                        <!-- Dynamic page selection buttons -->
                    </div>

                    <!-- Mini Page Information -->
                    <div class="p-3 rounded-xl bg-amber-50 dark:bg-slate-900/80 border border-amber-200 dark:border-amber-900/50 text-xs text-amber-900 dark:text-amber-200 space-y-1.5 mt-auto">
                        <p class="font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-lightbulb text-amber-600"></i>
                            <span>ई-पेपर कैसे पढ़ें?</span>
                        </p>
                        <p class="text-[11px] leading-relaxed opacity-90">
                            किसी भी खबर के शीर्षक या बॉक्स पर क्लिक करके उसे बड़े अक्षरों में पढ़ें, आवाज़ (Audio Reader) में सुनें या सोशल मीडिया पर शेयर करें।
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- MAIN NEWS GRID SECTION -->
        <section id="news" class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b-2 border-news-600 pb-3 gap-4">
                <h2 class="text-2xl sm:text-3xl font-bold font-hindi-serif text-slate-800 dark:text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-fire text-news-600 animate-pulse"></i> 
                    <span>मुख्य समाचार (Top Headlines)</span>
                </h2>

                <!-- News Category Filters -->
                <div class="flex flex-wrap gap-1.5" id="newsCategoryFilters">
                    <button onclick="filterNewsCategory('all')" class="news-cat-btn active px-3 py-1 rounded-lg text-xs font-bold bg-news-600 text-white shadow-sm transition">सभी खबरें</button>
                    <button onclick="filterNewsCategory('national')" class="news-cat-btn px-3 py-1 rounded-lg text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-news-100 transition">राष्ट्रीय</button>
                    <button onclick="filterNewsCategory('tech')" class="news-cat-btn px-3 py-1 rounded-lg text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-news-100 transition">तकनीक</button>
                    <button onclick="filterNewsCategory('sports')" class="news-cat-btn px-3 py-1 rounded-lg text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-news-100 transition">खेल</button>
                    <button onclick="filterNewsCategory('business')" class="news-cat-btn px-3 py-1 rounded-lg text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-news-100 transition">कारोबार</button>
                </div>
            </div>

            <!-- News Grid Cards -->
            <div id="mainNewsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Dynamic main news cards injected by JavaScript -->
            </div>
        </section>

        <!-- LOCAL & STATE NEWS SECTION -->
        <section id="local" class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl relative overflow-hidden">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-slate-800 pb-4 gap-4">
                <div>
                    <span class="text-xs font-bold uppercase text-news-400 tracking-wider">स्थानीय कवरेज</span>
                    <h2 class="text-2xl sm:text-3xl font-bold font-hindi-serif flex items-center gap-2 mt-0.5">
                        <i class="fa-solid fa-city text-amber-400"></i>
                        <span>आपकी नगर की विशेष खबरें: <span id="localEditionHeader" class="text-news-400">बरेली नगर</span></span>
                    </h2>
                </div>
                <div class="text-xs text-slate-400 font-medium">
                    अपडेट: आज 10:30 AM
                </div>
            </div>

            <div id="localNewsGrid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Local news items injected dynamically based on selected edition -->
            </div>
        </section>

        <!-- BLOGS & EDITORIAL SECTION -->
        <section id="blogs" class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 p-6 space-y-6">
            <div class="border-b border-slate-200 dark:border-slate-800 pb-3 flex items-center justify-between">
                <h2 class="text-2xl sm:text-3xl font-bold font-hindi-serif text-slate-800 dark:text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-pen-nib text-purple-600"></i>
