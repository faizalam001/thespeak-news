        function setupTicker() {
            const headlines = [
                "बरेली नगर में मेट्रो प्रोजेक्ट को हरी झंडी, जल्द शुरू होगा काम",
                "एशिया कप 2026: भारतीय टीम ने दर्ज की शानदार जीत",
                "डिजिटल भारत योजना के तहत ग्रामीण इंटरनेट नेटवर्क का विस्तार",
                "शेयर बाजार में रिकॉर्ड उछाल, सेंसेक्स 85,000 के पार",
                "मौसम अपडेट: उत्तर प्रदेश में अगले 48 घंटों में हल्की बारिश के असर"
            ];
            const container = document.getElementById('tickerContent');
            const items = headlines.map(h => `<span class="flex items-center gap-2"><i class="fa-solid fa-square text-[8px] text-news-500"></i> ${h}</span>`).join('');
            container.innerHTML = items + items; // Duplicate for smooth infinite scroll
        }

        // Render Page selector buttons
        function renderEpaperPagesButtons() {
            const container = document.getElementById('pageSelectorButtons');
            container.innerHTML = '';
            for (let i = 1; i <= 6; i++) {
                const btn = document.createElement('button');
                btn.className = `p-2.5 rounded-xl border text-xs font-bold transition flex flex-col items-center justify-center gap-1 ${
                    activeEpaperPage === i 
                        ? 'border-news-600 bg-news-600 text-white shadow-md' 
                        : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-news-500'
                }`;
                btn.onclick = () => switchEpaperPage(i);
                btn.innerHTML = `
                    <span>पन्ना 0${i}</span>
                    <span class="text-[10px] opacity-80">${i === 1 ? 'मुख्य' : i === 2 ? 'राज्य' : i === 3 ? 'खेल' : i === 4 ? 'व्यापार' : i === 5 ? 'विचार' : 'मनोरंजन'}</span>
                `;
                container.appendChild(btn);
            }
        }

        // Switch Epaper Page
        function switchEpaperPage(pageNum) {
            activeEpaperPage = pageNum;
            document.getElementById('activePageNumText').innerText = `0${pageNum}`;
            document.getElementById('activePageFooter').innerText = `0${pageNum}`;
            renderEpaperPagesButtons();
            renderEpaperPageContent(pageNum);
            showToast(`पन्ना 0${pageNum} लोड किया गया`);
        }

        // Render Epaper Page Articles
        function renderEpaperPageContent(pageNum) {
            const container = document.getElementById('epaperArticlesGrid');
            container.innerHTML = '';
            const pageData = epaperPagesData[pageNum] || epaperPagesData[1];

            pageData.articles.forEach(art => {
                const card = document.createElement('div');
                card.className = `${art.colSpan} epaper-hotspot bg-white p-4 rounded-xl cursor-pointer shadow-sm group transition-all`;
                card.onclick = () => openArticleModal(art);
                
                card.innerHTML = `
                    <div class="flex items-center justify-between mb-2">
                        <span class="${art.badgeColor} text-[10px] font-extrabold px-2 py-0.5 rounded-md uppercase tracking-wider">${art.badge}</span>
                        <span class="text-[10px] text-slate-400 font-bold"><i class="fa-solid fa-expand mr-1"></i> विस्तार में पढ़ें</span>
                    </div>
                    <h4 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-news-700 font-hindi-serif leading-snug mb-2">${art.title}</h4>
                    <p class="text-xs text-slate-600 font-hindi-body line-clamp-3 mb-3 leading-relaxed">${art.excerpt}</p>
                    ${art.image ? `<div class="h-32 w-full rounded-lg overflow-hidden my-2"><img src="${art.image}" class="w-full h-full object-cover group-hover:scale-105 transition-transform" alt=""></div>` : ''}
                    <div class="flex justify-between items-center text-[10px] text-slate-500 font-semibold pt-2 border-t border-slate-100">
                        <span><i class="fa-solid fa-feather mr-1"></i>${art.author}</span>
                        <span><i class="fa-solid fa-clock mr-1"></i>${art.time}</span>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Zoom Controls for Epaper
        function zoomEpaper(action) {
            const canvas = document.getElementById('epaperCanvasContainer');
            if (action === 'in' && epaperZoomLevel < 1.4) epaperZoomLevel += 0.1;
            if (action === 'out' && epaperZoomLevel > 0.8) epaperZoomLevel -= 0.1;
            canvas.style.transform = `scale(${epaperZoomLevel})`;
        }

        function resetZoomEpaper() {
            epaperZoomLevel = 1.0;
            document.getElementById('epaperCanvasContainer').style.transform = `scale(1.0)`;
        }

        function loadEpaperByDate() {
            const val = document.getElementById('epaperDatePicker').value;
            showToast(`दिनांक ${val} का डिजिटल ई-पेपर लोड हो रहा है...`);
        }

        function downloadEpaperPDFSim() {
            showToast('ई-पेपर पीडीएफ (PDF) डाउनलोड शुरू हो रहा है...');
        }

        // Edition Change Handler
        function changeEdition(editionKey) {
            activeEdition = editionKey;
            document.getElementById('editionSelect').value = editionKey;
            
            const nameMap = {
                bareilly: 'बरेली नगर',
                lucknow: 'लखनऊ',
                delhi: 'दिल्ली NCR',
                patna: 'पटना',
                varanasi: 'वाराणसी'
            };
            
            const name = nameMap[editionKey] || 'बरेली नगर';
            document.getElementById('topEditionLabel').innerText = name;
            document.getElementById('epaperEditionTitle').innerText = `${name} संस्करण`;
            document.getElementById('localEditionHeader').innerText = name;

            renderLocalNews(editionKey);
            showToast(`संस्करण बदलकर '${name}' किया गया`);
        }

        // Main News Grid Render
        function renderMainNewsGrid(filter) {
            const container = document.getElementById('mainNewsGrid');
            container.innerHTML = '';
            
            const filtered = filter === 'all' 
                ? mainNewsData 
                : mainNewsData.filter(n => n.category === filter);

            filtered.forEach(news => {
                const card = document.createElement('div');
                card.className = 'bg-white dark:bg-slate-900 rounded-2xl overflow-hidden shadow-md border border-slate-200 dark:border-slate-800 hover:shadow-xl transition-all flex flex-col justify-between group';
                card.onclick = () => openArticleModal(news);
                
                card.innerHTML = `
                    <div>
                        <div class="h-48 overflow-hidden relative">
                            <img src="${escapeHtml(news.image)}" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 bg-news-600 text-white text-[10px] font-extrabold px-2.5 py-1 rounded-lg shadow">${escapeHtml(news.categoryLabel)}</span>
                        </div>
                        <div class="p-5">
                            <h3 class="font-bold text-lg font-hindi-serif leading-snug group-hover:text-news-600 dark:group-hover:text-news-400 transition-colors mb-2">${escapeHtml(news.title)}</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-400 font-hindi-body leading-relaxed line-clamp-3">${escapeHtml(news.excerpt)}</p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-0 flex justify-between items-center text-[11px] text-slate-400 font-medium border-t border-slate-100 dark:border-slate-800/60 mt-2">
                        <span><i class="fa-solid fa-user-pen mr-1"></i> ${escapeHtml(news.author)}</span>
                        <span class="text-news-600 font-bold hover:underline cursor-pointer">आगे पढ़ें <i class="fa-solid fa-chevron-right text-[9px]"></i></span>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // Category Filter Tabs
        function filterNewsCategory(cat) {
            document.querySelectorAll('.news-cat-btn').forEach(btn => {
                btn.classList.remove('bg-news-600', 'text-white');
                btn.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
            });
            event.target.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
            event.target.classList.add('bg-news-600', 'text-white');
            renderMainNewsGrid(cat);
        }

        // Local Edition News Render
        function renderLocalNews(editionKey) {
            const container = document.getElementById('localNewsGrid');
            container.innerHTML = '';
            const items = localEditionData[editionKey] || localEditionData.bareilly;

            items.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = 'bg-slate-800/80 rounded-xl p-4 border border-slate-700 hover:border-news-500 transition cursor-pointer';
                card.onclick = () => openArticleModal({
                    title: item.title,
                    excerpt: item.text,
                    body: item.text + " विस्तृत रिपोर्ट जल्द प्रकाशित की जाएगी। द स्पीक रिपोर्टर ग्राउंड से अपडेट दे रहे हैं।",
                    author: "स्थानीय संवाददाता",
                    time: item.time,
                    categoryLabel: "स्थानीय"
                });
                card.innerHTML = `
                    <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1 block">खबर ${idx+1}</span>
                    <h4 class="font-bold text-sm text-white mb-1 leading-snug hover:text-news-400">${escapeHtml(item.title)}</h4>
                    <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed mb-3">${escapeHtml(item.text)}</p>
                    <span class="text-[10px] text-slate-400"><i class="fa-solid fa-clock mr-1"></i>${escapeHtml(item.time)}</span>
                `;
                container.appendChild(card);
            });
        }

        // Blogs Render
        function renderBlogs() {
            const container = document.getElementById('blogsContainer');
            container.innerHTML = '';
            blogsData.forEach(blog => {
                const div = document.createElement('div');
                div.className = 'p-5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-2';
                div.innerHTML = `
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-100 text-purple-800">विशेष विचार</span>
                    <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">${escapeHtml(blog.title)}</h3>
                    <p class="text-xs text-slate-500 font-medium">${escapeHtml(blog.author)} • ${escapeHtml(blog.date)}</p>
                    <p class="text-xs text-slate-600 dark:text-slate-300 font-hindi-body leading-relaxed">${escapeHtml(blog.summary)}</p>
                `;
                container.appendChild(div);
            });
        }

        // Gallery Render
        function renderGallery() {
            const container = document.getElementById('mediaGalleryGrid');
            container.innerHTML = '';
            mediaGalleryData.forEach(item => {
                const div = document.createElement('div');
                div.className = 'rounded-xl overflow-hidden relative group cursor-pointer shadow border border-slate-200 dark:border-slate-800';
                div.onclick = () => showToast(`मीडिया देखें: ${escapeHtml(item.title)}`);
                div.innerHTML = `
                    <div class="h-40 w-full overflow-hidden">
                        <img src="${escapeHtml(item.image)}" alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent flex flex-col justify-end p-3 text-white">
                        <span class="text-[9px] font-bold text-amber-400 uppercase tracking-widest">${item.type === 'video' ? 'वीडियो' : 'फोटो'}</span>
                        <p class="text-xs font-bold leading-tight line-clamp-2">${escapeHtml(item.title)}</p>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        // ARTICLE MODAL FUNCTIONS
        function openArticleModal(article) {
            currentModalArticle = article;
            
            document.getElementById('modalArticleTitle').innerText = article.title;
            document.getElementById('modalArticleAuthor').innerText = article.author || 'संवाददाता';
            document.getElementById('modalArticleTime').innerText = article.time || '15 सितंबर 2026';
            document.getElementById('modalCategoryTag').innerText = article.badge || article.categoryLabel || 'विशेष समाचार';
            
            const imgBox = document.getElementById('modalImageContainer');
            if (article.image) {
                imgBox.classList.remove('hidden');
                document.getElementById('modalArticleImage').src = article.image;
            } else {
                imgBox.classList.add('hidden');
            }

            document.getElementById('modalArticleBody').innerHTML = `
                <p class="text-lg font-bold text-slate-800 dark:text-slate-200 mb-3 leading-snug">${article.excerpt || ''}</p>
                <p>${article.body || article.excerpt || 'संवाददाता से मिली जानकारी के अनुसार विस्तृत विवरण तैयार किया जा रहा है। जुड़े रहें द स्पीक डिजिटल मीडिया के साथ।'}</p>
            `;

            document.getElementById('articleModal').classList.remove('hidden');
            stopAudioReader();
        }

        function closeArticleModal() {
            document.getElementById('articleModal').classList.add('hidden');
            stopAudioReader();
        }

        // Text-to-Speech Hindi Audio Reader
        function toggleAudioReader() {
            if ('speechSynthesis' in window) {
                if (isAudioPlaying) {
                    stopAudioReader();
                } else {
                    const textToRead = `${currentModalArticle.title}. ${currentModalArticle.excerpt || ''}`;
                    const utterance = new SpeechSynthesisUtterance(textToRead);
                    utterance.lang = 'hi-IN';
                    utterance.rate = 0.9;
                    
                    utterance.onend = () => {
                        stopAudioReader();
                    };

                    window.speechSynthesis.speak(utterance);
                    isAudioPlaying = true;
                    document.getElementById('ttsIcon').className = 'fa-solid fa-circle-stop text-rose-500 animate-pulse';
                    document.getElementById('ttsText').innerText = 'रोकें (Stop)';
                    showToast('वॉइस रीडर चालू है...');
                }
            } else {
                showToast('आपके ब्राउज़र में वॉइस रीडर समर्थित नहीं है।');
            }
        }

        function stopAudioReader() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
            isAudioPlaying = false;
            const icon = document.getElementById('ttsIcon');
            const txt = document.getElementById('ttsText');
            if (icon && txt) {
                icon.className = 'fa-solid fa-volume-high';
                txt.innerText = 'खबर सुनें (Audio)';
            }
        }

        // Font Adjuster in Modal
        function adjustArticleFontSize(delta) {
            currentFontSizeLevel = Math.max(12, Math.min(24, currentFontSizeLevel + delta));
            document.getElementById('modalArticleBody').style.fontSize = `${currentFontSizeLevel}px`;
        }

        // Bookmarks System
        function toggleBookmarkCurrentArticle() {
            if (!currentModalArticle) return;
            const idx = savedBookmarks.findIndex(b => b.title === currentModalArticle.title);
            if (idx >= 0) {
                savedBookmarks.splice(idx, 1);
                showToast('खबर सेव की गई सूची से हटा दी गई।');
            } else {
                savedBookmarks.push(currentModalArticle);
                showToast('खबर सफलता पूर्वक सेव हो गई!');
            }
            updateBookmarkBadge();
        }

        function updateBookmarkBadge() {
            document.getElementById('bookmarkCount').innerText = savedBookmarks.length;
        }

        function openBookmarksModal() {
            const container = document.getElementById('bookmarksList');
            container.innerHTML = '';

            if (savedBookmarks.length === 0) {
                container.innerHTML = '<p class="text-xs text-slate-500 text-center py-8">कोई खबर सेव नहीं की गई है।</p>';
            } else {
                savedBookmarks.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs space-y-1';
                    div.innerHTML = `
                        <h4 class="font-bold text-slate-800 dark:text-slate-100 hover:text-news-600 cursor-pointer" onclick="openArticleModalFromBookmark('${item.title}')">${item.title}</h4>
                        <p class="text-[10px] text-slate-400">${item.time || ''}</p>
                    `;
                    container.appendChild(div);
                });
            }
            document.getElementById('bookmarksModal').classList.remove('hidden');
        }

        function closeBookmarksModal() {
            document.getElementById('bookmarksModal').classList.add('hidden');
        }

        function clearAllBookmarks() {
            savedBookmarks = [];
            updateBookmarkBadge();
            openBookmarksModal();
            showToast('सभी सेव खबरें हटा दी गईं।');
        }

        // Horoscope Update
        function updateHoroscope(zodiacKey) {
            const data = {
                aries: { title: "मेष राशि - आज का दिन शुभ फलदायी", body: "कार्यक्षेत्र में नई जिम्मेदारियां मिल सकती हैं। आर्थिक स्थिति में सुधार होगा और परिवार में मांगलिक कार्य के योग बनेंगे।", color: "लाल", number: "9" },
                taurus: { title: "वृषभ राशि - व्यापार में लाभ के अवसर", body: "व्यापार में नए सौदे फाइनल हो सकते हैं। मित्रों का पूर्ण सहयोग मिलेगा। स्वास्थ्य का विशेष ध्यान रखें।", color: "सफेद", number: "6" },
                gemini: { title: "मिथुन राशि - बौद्धिक कार्यों में सफलता", body: "सृजनात्मक कार्यों में रुचि बढ़ेगी। नौकरीपेशा लोगों को पदोन्नति का शुभ समाचार मिल सकता है।", color: "हरा", number: "5" },
                cancer: { title: "कर्क राशि - पारिवारिक सुख व शांति", body: "घर-परिवार में आनंद का माहौल रहेगा। धन निवेश के मामलों में सावधानी बरतें।", color: "पीला", number: "2" },
                leo: { title: "सिंह राशि - नेतृत्व क्षमता में वृद्धि", body: "सामाजिक प्रतिष्ठा में वृद्धि होगी। अटके हुए सरकारी काम पूरे होंगे। आत्मविश्वास उच्च रहेगा।", color: "नारंगी", number: "1" },
                virgo: { title: "कन्या राशि - नई योजनाओं की शुरुआत", body: "करियर में सकारात्मक बदलाव देखने को मिलेंगे। विद्यार्थियों के लिए आज का दिन अत्यंत शुभ है।", color: "नीला", number: "7" }
            };

            const selected = data[zodiacKey] || data.aries;
            document.getElementById('horoscopeTitle').innerText = selected.title;
            document.getElementById('horoscopeBody').innerText = selected.body;
        }

        // Public Poll Vote
        function castVote(option) {
            let count = 1842 + 1;
            document.getElementById('totalVotesCount').innerText = count.toLocaleString('hi-IN');
            document.getElementById('pollStatusBadge').innerText = 'आपका वोट दर्ज हुआ!';
            showToast('जनमत सर्वेक्षण में वोट देने के लिए धन्यवाद!');
        }

        // Search Handlers
        function handleSearchKey(e) {
            if (e.key === 'Enter') executeSearch();
        }

        function executeSearch() {
            const query = document.getElementById('searchInput').value.trim();
            if (query) {
                showToast(`'${query}' के लिए खोज परिणाम...`);
            }
        }

        // Dark Mode Toggle
        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
            const icon = document.getElementById('themeIcon');
            if (document.documentElement.classList.contains('dark')) {
                icon.className = 'fa-solid fa-sun text-amber-300';
                showToast('डार्क मोड एक्टिव');
            } else {
                icon.className = 'fa-solid fa-moon';
                showToast('लाइट मोड एक्टिव');
            }
        }

        // Action Simulations
        function handleNewsletterSubmit(e) {
            e.preventDefault();
            showToast('न्यूज़लेटर सदस्यता सफलतापूर्वक हो गई!');
            e.target.reset();
        }

        function shareArticleSim() {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href);
            }
            showToast('खबर का लिंक कॉपी हो गया है!');
        }

        function printArticleSim() {
            window.print();
        }

        function openContactModal() {
            showToast('न्यूज़ डेस्क संपर्क: 1800-SPEAK-NEWS | contact@thespeaknews.com');
        }

        // Toast Feedback System
        function showToast(msg) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'bg-slate-900 text-white border-l-4 border-news-500 px-4 py-3 rounded-xl shadow-2xl text-xs font-bold flex items-center gap-2 animate-bounce transition-all';
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-news-500"></i> <span>${msg}</span>`;
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>