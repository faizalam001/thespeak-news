    <div id="toastContainer" class="fixed bottom-6 right-6 z-50 space-y-2 pointer-events-none"></div>

    <script>
        // SECURITY: Input sanitization helper
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function sanitizeHtml(html) {
            // Basic sanitization - remove script tags and dangerous attributes
            const temp = document.createElement('div');
            temp.innerHTML = html;
            
            // Remove script tags
            const scripts = temp.querySelectorAll('script');
            scripts.forEach(script => script.remove());
            
            // Remove dangerous attributes
            const allElements = temp.querySelectorAll('*');
            allElements.forEach(el => {
                const dangerousAttrs = ['onclick', 'onload', 'onerror', 'onmouseover', 'onmouseout', 'onfocus', 'onblur'];
                dangerousAttrs.forEach(attr => {
                    if (el.hasAttribute(attr)) {
                        el.removeAttribute(attr);
                    }
                });
            });
            
            return temp.innerHTML;
        }

        // APPLICATION DATA STATE
        let activeEdition = 'bareilly';
        let activeEpaperPage = 1;
        let epaperZoomLevel = 1.0;
        let savedBookmarks = [];
        let currentModalArticle = null;
        let isAudioPlaying = false;
        let currentFontSizeLevel = 16; // px

        // E-PAPER PAGE ARTICLES DATA (6 Pages)
        const epaperPagesData = {
            1: {
                pageTitle: "पन्ना 01 (मुख्य समाचार)",
                articles: [
                    {
                        id: 'ep-101',
                        colSpan: 'md:col-span-8',
                        badge: 'बड़ी ख़बर',
                        badgeColor: 'bg-news-100 text-news-800',
                        title: 'बरेली नगर में लाइट मेट्रो प्रोजेक्ट को मिली अंतिम स्वीकृति, 2027 तक परिचालन का लक्ष्य',
                        excerpt: 'बरेली नगर निगम एवं उत्तर प्रदेश शासन की उच्चस्तरीय समीक्षा बैठक में शहर के प्रथम मेट्रो कॉरिडोर को हरी झंडी दे दी गई है...',
                        body: 'बरेली नगर निगम की महत्वपूर्ण बैठक में आज शहर के यातायात ढाँचे को नया रूप देने के लिए लाइट मेट्रो रेल परियोजना को औपचारिक स्वीकृति प्रदान कर दी गई। प्रथम चरण में कुतुबखाना से लेकर जंक्शन और सेटेलाइट बस स्टैंड तक 14 किलोमीटर लंबा एलिवेटेड ट्रैक बनाया जाएगा। इस परियोजना की कुल लागत ₹2,400 करोड़ आंकी गई है।',
                        author: 'विशेष रिपोर्टर, बरेली',
                        time: '15 सितंबर 2026 • पृष्ठ 01',
                        image: 'https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=800&q=80'
                    },
                    {
                        id: 'ep-102',
                        colSpan: 'md:col-span-4',
                        badge: 'रोजगार',
